---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const socials = [
	{ label: 'Instagram', href: 'https://www.instagram.com/lleyton_lewis/' },
	{ label: 'Media Instagram', href: 'https://www.instagram.com/lleytonlewismedia/' },
	{ label: 'YouTube', href: 'https://www.youtube.com/@Lleyton_Lewis' },
	{ label: 'Twitter/X', href: 'https://x.com/LleytonLewis' },
	{ label: 'Letterboxd', href: 'https://letterboxd.com/LleytonLewis/' },
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<p class="eyebrow">Filmmaker &amp; Photographer</p>
					<h1>Lleyton Lewis</h1>
					<p class="hero-sub">
						Based in Toronto.
					</p>

					<div class="social-buttons">
						{socials.map((social) => (
							<a class="social-btn" href={social.href} target="_blank" rel="noopener noreferrer">
								{social.label}
							</a>
						))}
					</div>
				</div>

				<img
					class="hero-image"
					src="/homepageportrait.jpg"
					alt="Lleyton Lewis, filmmaker and photographer"
				/>
			</section>

			<section class="work" id="work">
				<div class="work-header">
					<h2>Most Recent Work</h2>
					<a class="view-all" href="/work">View all &rarr;</a>
				</div>

				<!-- ============================================ -->
				<!-- 🎬 ADD YOUR MOST RECENT VIDEO/PHOTO HERE     -->
				<!-- Replace .thumb div with a <video> or <img>     -->
				<!-- ============================================ -->
				<a class="recent-work" href="/work/most-recent-project">
					<div class="thumb">
						<span class="thumb-label">Add video or photo</span>
					</div>
					<div class="recent-work-meta">
						<h3>Project Title</h3>
						<p>Short Film</p>
					</div>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		width: auto;
		max-width: none;
		padding: 0;
	}
	.hero {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem 6rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
		min-height: 80vh;
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.5);
		margin: 0 0 1rem;
	}
	.hero h1 {
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		line-height: 1;
		margin: 0;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #f2f2f0;
	}
	.hero-sub {
		margin: 1.5rem 0 0;
		max-width: 32ch;
		font-size: 1.05rem;
		line-height: 1.6;
		color: rgba(242, 242, 240, 0.65);
	}
	.social-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 2rem;
	}
	.social-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.55em 1em;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 100px;
		color: rgba(242, 242, 240, 0.75);
		font-size: 0.78rem;
		letter-spacing: 0.03em;
		text-decoration: none;
		transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
	}
	.social-btn:hover {
		color: #f2f2f0;
		border-color: rgba(232, 185, 120, 0.5);
		background: rgba(232, 185, 120, 0.08);
	}
	.hero-image {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 4px;
		display: block;
	}

	.work {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 2rem 8rem;
	}
	.work-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 2rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 1.25rem;
	}
	.work-header h2 {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: #f2f2f0;
	}
	.view-all {
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.55);
		text-decoration: none;
		letter-spacing: 0.03em;
		transition: color 0.25s ease;
	}
	.view-all:hover {
		color: #f2f2f0;
	}
	.recent-work {
		display: block;
		text-decoration: none;
		color: inherit;
		max-width: 800px;
	}
	.thumb {
		aspect-ratio: 16 / 9;
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.06);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		transition: border-color 0.25s ease;
	}
	.recent-work:hover .thumb {
		border-color: rgba(255, 255, 255, 0.2);
	}
	.thumb-label {
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.3);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.recent-work-meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-top: 1rem;
	}
	.recent-work-meta h3 {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 500;
		color: #f2f2f0;
	}
	.recent-work-meta p {
		margin: 0;
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.45);
	}
	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			padding: 3rem 1.5rem 4rem;
			min-height: auto;
		}
		.hero-image {
			aspect-ratio: 16 / 10;
			order: -1;
		}
		.work {
			padding: 2rem 1.5rem 6rem;
		}
	}
</style>
