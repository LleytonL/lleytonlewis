---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const featuredWork = [
	{ title: 'Project One', category: 'Short Film', href: '/work/project-one' },
	{ title: 'Project Two', category: 'Commercial', href: '/work/project-two' },
	{ title: 'Project Three', category: 'Music Video', href: '/work/project-three' },
	{ title: 'Project Four', category: 'Documentary', href: '/work/project-four' },
];
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Filmmaker &amp; Photographer</p>
				<h1>Your Name</h1>
				<p class="hero-sub">
					Telling stories through motion and light. Based in [City] —
					available worldwide.
				</p>
				<a class="scroll-cue" href="#work" aria-label="Scroll to work">
					<span></span>
				</a>
			</section>

			<section class="work" id="work">
				<div class="work-header">
					<h2>Selected Work</h2>
					<a class="view-all" href="/work">View all &rarr;</a>
				</div>
				<div class="work-grid">
					{featuredWork.map((project) => (
						<a class="work-item" href={project.href}>
							<div class="thumb">
								<span class="thumb-label">Add thumbnail</span>
							</div>
							<div class="work-item-meta">
								<h3>{project.title}</h3>
								<p>{project.category}</p>
							</div>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		background: #0a0a0a;
		color: #f2f2f0;
	}
	.hero {
		min-height: 90vh;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		padding: 0 2rem;
		max-width: 900px;
		margin: 0 auto;
		position: relative;
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.5);
		margin: 0 0 1rem;
	}
	.hero h1 {
		font-size: clamp(2.75rem, 8vw, 5.5rem);
		line-height: 1;
		margin: 0;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.hero-sub {
		margin: 1.5rem 0 0;
		max-width: 32ch;
		font-size: 1.05rem;
		line-height: 1.6;
		color: rgba(242, 242, 240, 0.65);
	}
	.scroll-cue {
		position: absolute;
		bottom: 2.5rem;
		left: 2rem;
		width: 1px;
		height: 3.5rem;
		background: rgba(242, 242, 240, 0.25);
		overflow: hidden;
	}
	.scroll-cue span {
		display: block;
		width: 100%;
		height: 40%;
		background: #f2f2f0;
		animation: scroll-down 1.8s ease-in-out infinite;
	}
	@keyframes scroll-down {
		0% { transform: translateY(-100%); }
		100% { transform: translateY(250%); }
	}

	.work {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem 8rem;
	}
	.work-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 2rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 1.25rem;
	}
	.work-header h2 {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.view-all {
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.55);
		text-decoration: none;
		letter-spacing: 0.03em;
		transition: color 0.25s ease;
	}
	.view-all:hover {
		color: #f2f2f0;
	}
	.work-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 1.5rem;
	}
	.work-item {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.thumb {
		aspect-ratio: 16 / 10;
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.06);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		transition: border-color 0.25s ease;
	}
	.work-item:hover .thumb {
		border-color: rgba(255, 255, 255, 0.2);
	}
	.thumb-label {
		font-size: 0.75rem;
		color: rgba(242, 242, 240, 0.3);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.work-item-meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-top: 0.85rem;
	}
	.work-item-meta h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
	}
	.work-item-meta p {
		margin: 0;
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.45);
	}
	@media (max-width: 720px) {
		.work-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
