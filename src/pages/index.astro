---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const socials = [
	{ 
		label: 'Instagram', 
		subLabel: 'Personal',
		href: 'https://www.instagram.com/lleyton_lewis/',
		icon: 'instagram'
	},
	{ 
		label: 'Instagram', 
		subLabel: 'Media & Work',
		href: 'https://www.instagram.com/lleytonlewismedia/',
		icon: 'instagram'
	},
	{ 
		label: 'YouTube', 
		subLabel: 'Videos & Films',
		href: 'https://www.youtube.com/@Lleyton_Lewis',
		icon: 'youtube'
	},
	{ 
		label: 'Twitter / X', 
		subLabel: 'Updates',
		href: 'https://x.com/LleytonLewis',
		icon: 'x'
	},
	{ 
		label: 'Letterboxd', 
		subLabel: 'Film Logs',
		href: 'https://letterboxd.com/LleytonLewis/',
		icon: 'letterboxd'
	},
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<p class="eyebrow">Filmmaker &amp; Photographer</p>
					<h1>Lleyton Lewis</h1>
<br>
					<p class="eyebrow">
						Based in Toronto, Canada
					</p>

					<!-- Icon Cards with Labels Underneath -->
					<div class="social-grid">
						{socials.map((social) => (
							<a class="social-card" href={social.href} target="_blank" rel="noopener noreferrer">
								<div class="icon-wrapper">
									{social.icon === 'instagram' && (
										<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
											<rect x="2.5" y="2.5" width="19" height="19" rx="5"></rect>
											<circle cx="12" cy="12" r="4.2"></circle>
											<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"></circle>
										</svg>
									)}
									{social.icon === 'youtube' && (
										<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="currentColor">
											<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
										</svg>
									)}
									{social.icon === 'x' && (
										<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor">
											<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
										</svg>
									)}
									{social.icon === 'letterboxd' && (
										<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="currentColor">
											<circle cx="7" cy="12" r="3.5" opacity="0.9"/>
											<circle cx="12" cy="12" r="3.5" opacity="0.9"/>
											<circle cx="17" cy="12" r="3.5" opacity="0.9"/>
										</svg>
									)}
								</div>
								<div class="label-block">
									<span class="social-title">{social.label}</span>
									<span class="social-sub">{social.subLabel}</span>
								</div>
							</a>
						))}
					</div>
				</div>

				<img
					class="hero-image"
					src="/homepageportrait.jpg"
					alt="Lleyton Lewis, filmmaker and photographer"
				/>
			</section>

			<section class="work" id="work">
				<div class="work-header">
					<h2>Most Recent Work</h2>
					<a class="view-all" href="/work">View all &rarr;</a>
				</div>

				<a class="recent-work" href="/work/most-recent-project">
					<div class="thumb">
						<span class="thumb-label">Add video or photo</span>
					</div>
					<div class="recent-work-meta">
						<h3>Project Title</h3>
						<p>Short Film</p>
					</div>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: auto;
		max-width: none;
		padding: 0;
	}
	.hero {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem 6rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
		min-height: 80vh;
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.5);
		margin: 0 0 1rem;
	}
	.hero h1 {
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		line-height: 1;
		margin: 0;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #f2f2f0;
	}
	.hero-sub {
		margin: 1.5rem 0 0;
		max-width: 32ch;
		font-size: 1.05rem;
		line-height: 1.6;
		color: rgba(242, 242, 240, 0.65);
	}

	/* Social Cards Grid */
	.social-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
		gap: 0.75rem;
		margin-top: 2.5rem;
	}

	.social-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 0.85rem 0.9rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.social-card:hover {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
	}

	.icon-wrapper {
		width: 34px;
		height: 34px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.05);
		border-radius: 8px;
		color: rgba(242, 242, 240, 0.8);
		margin-bottom: 0.75rem;
		transition: color 0.25s ease, background 0.25s ease;
	}

	.social-card:hover .icon-wrapper {
		color: #f2f2f0;
		background: rgba(232, 185, 120, 0.15);
	}

	.label-block {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.social-title {
		font-size: 0.82rem;
		font-weight: 500;
		color: #f2f2f0;
		letter-spacing: -0.01em;
	}

	.social-sub {
		font-size: 0.68rem;
		color: rgba(242, 242, 240, 0.45);
		line-height: 1.2;
	}

	.hero-image {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 4px;
		display: block;
	}

	.work {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 2rem 8rem;
	}
	.work-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 2rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 1.25rem;
	}
	.work-header h2 {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: #f2f2f0;
	}
	.view-all {
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.55);
		text-decoration: none;
		letter-spacing: 0.03em;
		transition: color 0.25s ease;
	}
	.view-all:hover {
		color: #f2f2f0;
	}
	.recent-work {
		display: block;
		text-decoration: none;
		color: inherit;
		max-width: 800px;
	}
	.thumb {
		aspect-ratio: 16 / 9;
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.06);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		transition: border-color 0.25s ease;
	}
	.recent-work:hover .thumb {
		border-color: rgba(255, 255, 255, 0.2);
	}
	.thumb-label {
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.3);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.recent-work-meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-top: 1rem;
	}
	.recent-work-meta h3 {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 500;
		color: #f2f2f0;
	}
	.recent-work-meta p {
		margin: 0;
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.45);
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			padding: 3rem 1.5rem 4rem;
			min-height: auto;
		}
		.hero-image {
			aspect-ratio: 16 / 10;
			order: -1;
		}
		.work {
			padding: 2rem 1.5rem 6rem;
		}
		.social-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 480px) {
		.social-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
