---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const featuredWork = [
	{
		title: 'Maple Syrup',
		category: 'Short Film',
		type: 'Video',
		date: '2026-04-13',
		description: 'Directed by Sahym Akhtar, Cinematography by Lleyton Lewis',
		embedUrl: 'https://player.vimeo.com/video/1181018682',
	},
	{
		title: 'Cheating',
		category: 'Short Film',
		type: 'Video',
		date: '2026-02-23',
		description: 'Filmed, Directed, Written, and Edited by Lleyton Lewis',
		embedUrl: 'https://www.youtube.com/embed/Q0N6TAI0Fog',
	},
	{
		title: 'Japan to Shanghai to Hong Kong',
		category: 'Short Film / Vlog',
		type: 'Video',
		date: '2026-01-22',
		description: 'Filmed and Directed by Lleyton Lewis',
		embedUrl: 'https://www.youtube.com/embed/fzWvIyv3RSQ',
	},
	{
		title: "Don't Open The Door",
		category: 'Short Film',
		type: 'Video',
		date: '2025-09-06',
		description: 'Filmed, Directed, Written, and Edited by Lleyton Lewis',
		embedUrl: 'https://www.youtube.com/embed/coZQAvgHAdM',
	},
	{
		title: 'You Better Watch Out',
		category: 'Short Film',
		type: 'Video',
		date: '2025-01-22',
		description: 'Filmed, Directed, Written, and Edited by Lleyton Lewis',
		embedUrl: 'https://www.youtube.com/embed/PJqxnueY8gA',
	},
	{
		title: 'Star Wars - Fan Film',
		category: 'Short Film',
		type: 'Video',
		date: '2024-06-17',
		description: 'Filmed, Directed, Written, and Edited by Lleyton Lewis',
		embedUrl: 'https://www.youtube.com/embed/7ZKJt1US5vY',
	},
	{
		title: 'Doob: The Movie',
		category: 'Short Film',
		type: 'Video',
		date: '2024-04-12',
		description: 'Filmed, Directed, Written, and Edited by Lleyton Lewis',
		embedUrl: 'https://www.youtube.com/embed/5KZmltfoeR4',
	},
];

// Automatically sort all work from newest to oldest by date
const sortedWork = [...featuredWork].sort(
	(a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<BaseHead title={`My Work | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<h1>My Work</h1>
				</div>
			</section>

			<section class="work" id="work">
				<div class="work-header">
					<h2>Selected Work</h2>
					
					<!-- Filter Controls -->
					<div class="filter-tabs">
						<button class="filter-btn active" data-filter="all">All</button>
						<button class="filter-btn" data-filter="Video">Videos</button>
						<button class="filter-btn" data-filter="Photo">Photos</button>
					</div>

					<div class="updated-at">
						Updated as of: <span id="current-date">July 2026</span>
					</div>
				</div>

				<div class="work-grid">
					{sortedWork.map((project) => (
						<div class="work-item" data-type={project.type}>
							<div class="video-embed-wrapper">
								<iframe 
									src={project.embedUrl} 
									frameborder="0" 
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
									allowfullscreen
									title={project.title}
								></iframe>
							</div>
							<div class="work-item-meta">
								<div class="meta-main">
									<h3>{project.title}</h3>
									<p class="category">{project.category}</p>
									<p class="description">{project.description}</p>
								</div>
								<time datetime={project.date}>
									{new Date(project.date).toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										timeZone: 'UTC'
									})}
								</time>
							</div>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// Set current date dynamically on client load
			const dateSpan = document.getElementById('current-date');
			if (dateSpan) {
				const today = new Date();
				dateSpan.textContent = today.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'long',
					day: 'numeric'
				});
			}

			// Client-side filtering logic
			const filterBtns = document.querySelectorAll('.filter-btn');
			const workItems = document.querySelectorAll('.work-item');

			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					filterBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');

					const filterValue = btn.getAttribute('data-filter');

					workItems.forEach(item => {
						const itemType = item.getAttribute('data-type');
						if (filterValue === 'all' || itemType === filterValue) {
							(item as HTMLElement).style.display = 'flex';
						} else {
							(item as HTMLElement).style.display = 'none';
						}
					});
				});
			});
		</script>
	</body>
</html>

<style>
	main {
		width: auto;
		max-width: none;
		padding: 0;
	}
	.hero {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem 2rem;
		display: flex;
		align-items: center;
		min-height: 20vh;
	}
	.hero h1 {
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		line-height: 1;
		margin: 0;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #f2f2f0;
	}

	.work {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 2rem 8rem;
	}
	.work-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 1.25rem;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.work-header h2 {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: #f2f2f0;
	}

	.filter-tabs {
		display: flex;
		gap: 0.5rem;
	}
	.filter-btn {
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: rgba(242, 242, 240, 0.6);
		padding: 0.4rem 0.9rem;
		font-size: 0.85rem;
		border-radius: 4px;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.filter-btn:hover {
		color: #f2f2f0;
		border-color: rgba(255, 255, 255, 0.3);
	}
	.filter-btn.active {
		background: #f2f2f0;
		color: #141414;
		border-color: #f2f2f0;
		font-weight: 500;
	}

	.updated-at {
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.5);
		letter-spacing: 0.02em;
	}
	.updated-at span {
		color: #f2f2f0;
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 3.5rem 2rem;
	}

	.work-item {
		display: flex;
		flex-direction: column;
	}

	.video-embed-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #141414;
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	.video-embed-wrapper iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.work-item-meta {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		margin-top: 1rem;
		gap: 1rem;
	}
	.meta-main {
		display: flex;
		flex-direction: column;
	}
	.work-item-meta h3 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		color: #f2f2f0;
		letter-spacing: -0.01em;
	}
	.work-item-meta .category {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.5);
	}
	.work-item-meta .description {
		margin: 0.5rem 0 0;
		font-size: 0.88rem;
		line-height: 1.4;
		color: rgba(242, 242, 240, 0.65);
	}
	.work-item-meta time {
		font-size: 0.82rem;
		color: rgba(242, 242, 240, 0.4);
		white-space: nowrap;
		padding-top: 0.2rem;
	}

	@media (max-width: 900px) {
		.hero {
			padding: 3rem 1.5rem 2rem;
		}
		.work {
			padding: 2rem 1.5rem 6rem;
		}
		.work-grid {
			grid-template-columns: 1fr;
		}
		.work-header {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
