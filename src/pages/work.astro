---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Preloaded items (Replace image paths with your actual public/ folder files)
const initialWork = [
	{
		id: '1',
		title: 'Project One',
		category: 'Short Film',
		type: 'Video',
		date: '2026-05-15',
		description: 'A visual exploration of narrative structure.',
		youtubeUrl: '', // Add your YouTube video link here
		image: '',
	},
	{
		id: '2',
		title: 'Photo Series A',
		category: 'Editorial',
		type: 'Photo',
		date: '2026-04-10',
		description: '35mm portraiture set in Toronto.',
		youtubeUrl: '',
		image: '', // Add local path like '/work/photo-a.jpg'
	},
	{
		id: '3',
		title: 'Project Two',
		category: 'Commercial',
		type: 'Video',
		date: '2026-02-01',
		description: 'Brand commercial visual design.',
		youtubeUrl: '',
		image: '',
	},
	{
		id: '4',
		title: 'Photo Series B',
		category: 'Portrait',
		type: 'Photo',
		date: '2025-11-20',
		description: 'Studio light setup series.',
		youtubeUrl: '',
		image: '',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<BaseHead title={`My Work | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<h1>My Work</h1>
				</div>
			</section>

			<section class="work" id="work">
				<div class="work-header">
					<h2>Selected Work</h2>

					<!-- Filter Controls -->
					<div class="filter-tabs">
						<button class="filter-btn active" data-filter="all">All</button>
						<button class="filter-btn" data-filter="Video">Videos</button>
						<button class="filter-btn" data-filter="Photo">Photos</button>
					</div>

					<div class="updated-at">
						Updated as of: <span id="current-date">July 2026</span>
					</div>
				</div>

				<!-- Dynamic Container Rendered on Client -->
				<div class="work-grid" id="work-grid"></div>
			</section>
		</main>

		<!-- Floating Add Work Button -->
		<button id="open-modal-btn" class="fab-btn" aria-label="Add new work">
			<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="12" y1="5" x2="12" y2="19"></line>
				<line x1="5" y1="12" x2="19" y2="12"></line>
			</svg>
		</button>

		<!-- Add Work Modal -->
		<div id="upload-modal" class="modal-overlay">
			<div class="modal-card">
				<div class="modal-header">
					<h3>Add New Work</h3>
					<button id="close-modal-btn" class="close-btn">&times;</button>
				</div>

				<form id="add-work-form">
					<div class="form-group">
						<label>Media Type</label>
						<div class="type-selector">
							<label class="radio-label">
								<input type="radio" name="mediaType" value="Video" checked />
								<span>YouTube Video</span>
							</label>
							<label class="radio-label">
								<input type="radio" name="mediaType" value="Photo" />
								<span>Image Upload</span>
							</label>
						</div>
					</div>

					<div class="form-group">
						<label for="title">Title</label>
						<input type="text" id="title" required placeholder="e.g. Short Film Title" />
					</div>

					<div class="form-group">
						<label for="category">Category</label>
						<input type="text" id="category" required placeholder="e.g. Narrative, Editorial, Commercial" />
					</div>

					<div class="form-group">
						<label for="date">Date</label>
						<input type="date" id="date" required />
					</div>

					<!-- YouTube URL Input -->
					<div class="form-group" id="youtube-field">
						<label for="youtubeUrl">YouTube URL</label>
						<input type="url" id="youtubeUrl" placeholder="https://www.youtube.com/watch?v=..." />
					</div>

					<!-- Direct Computer Image Upload Input -->
					<div class="form-group hidden" id="image-field">
						<label for="imageFile">Select Image from Computer</label>
						<input type="file" id="imageFile" accept="image/*" />
					</div>

					<div class="form-group">
						<label for="description">Description</label>
						<textarea id="description" rows="3" placeholder="Brief project overview..."></textarea>
					</div>

					<button type="submit" class="submit-btn">Add to Gallery</button>
				</form>
			</div>
		</div>

		<Footer />

		<script is:inline define:vars={{ initialWork }}>
			let workItems = [...initialWork];
			let activeFilter = 'all';

			function getYouTubeEmbedUrl(url) {
				if (!url) return '';
				const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
				const match = url.match(regExp);
				return (match && match[2].length === 11)
					? `https://www.youtube.com/embed/${match[2]}`
					: url;
			}

			function renderWork() {
				const container = document.getElementById('work-grid');
				if (!container) return;

				const sorted = [...workItems].sort(
					(a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
				);

				container.innerHTML = '';

				sorted.forEach(item => {
					if (activeFilter !== 'all' && item.type !== activeFilter) {
						return;
					}

					const card = document.createElement('div');
					card.className = 'work-card';

					let mediaHTML = '';
					if (item.type === 'Video' && item.youtubeUrl) {
						const embedUrl = getYouTubeEmbedUrl(item.youtubeUrl);
						mediaHTML = `
							<div class="video-embed-wrapper">
								<iframe 
									src="${embedUrl}" 
									frameborder="0" 
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
									allowfullscreen
									title="${item.title}"
								></iframe>
							</div>
						`;
					} else if (item.image) {
						mediaHTML = `
							<div class="thumb">
								<img src="${item.image}" alt="${item.title}" loading="lazy" />
								<span class="type-badge">${item.type}</span>
							</div>
						`;
					} else {
						mediaHTML = `
							<div class="thumb">
								<span class="thumb-label">No Media Uploaded</span>
								<span class="type-badge">${item.type}</span>
							</div>
						`;
					}

					const formattedDate = new Date(item.date).toLocaleDateString('en-US', {
						year: 'numeric',
						month: 'short',
						timeZone: 'UTC'
					});

					card.innerHTML = `
						${mediaHTML}
						<div class="work-item-meta">
							<div class="meta-main">
								<h3>${item.title}</h3>
								<p class="category">${item.category}</p>
								${item.description ? `<p class="description">${item.description}</p>` : ''}
							</div>
							<time datetime="${item.date}">${formattedDate}</time>
						</div>
					`;

					container.appendChild(card);
				});
			}

			const dateSpan = document.getElementById('current-date');
			if (dateSpan) {
				const today = new Date();
				dateSpan.textContent = today.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'long',
					day: 'numeric'
				});
			}

			const filterBtns = document.querySelectorAll('.filter-btn');
			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					filterBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					activeFilter = btn.getAttribute('data-filter') || 'all';
					renderWork();
				});
			});

			const modal = document.getElementById('upload-modal');
			const openBtn = document.getElementById('open-modal-btn');
			const closeBtn = document.getElementById('close-modal-btn');
			const radioBtns = document.querySelectorAll('input[name="mediaType"]');
			const ytField = document.getElementById('youtube-field');
			const imgField = document.getElementById('image-field');
			const form = document.getElementById('add-work-form');

			openBtn?.addEventListener('click', () => {
				const password = prompt('Enter password to add work:');
				if (password === 'shopping') {
					modal?.classList.add('active');
				} else if (password !== null) {
					alert('Incorrect password!');
				}
			});

			closeBtn?.addEventListener('click', () => modal?.classList.remove('active'));
			
			modal?.addEventListener('click', (e) => {
				if (e.target === modal) modal.classList.remove('active');
			});

			radioBtns.forEach(radio => {
				radio.addEventListener('change', (e) => {
					const val = e.target.value;
					if (val === 'Video') {
						ytField?.classList.remove('hidden');
						imgField?.classList.add('hidden');
					} else {
						ytField?.classList.add('hidden');
						imgField?.classList.remove('hidden');
					}
				});
			});

			form?.addEventListener('submit', (e) => {
				e.preventDefault();

				const title = document.getElementById('title').value;
				const category = document.getElementById('category').value;
				const date = document.getElementById('date').value;
				const description = document.getElementById('description').value;
				const mediaType = document.querySelector('input[name="mediaType"]:checked').value;
				
				let youtubeUrl = '';

				if (mediaType === 'Video') {
					youtubeUrl = document.getElementById('youtubeUrl').value;
					addNewWorkItem({ title, category, date, description, mediaType, youtubeUrl, image: '' });
				} else {
					const fileInput = document.getElementById('imageFile');
					if (fileInput.files && fileInput.files[0]) {
						const reader = new FileReader();
						reader.onload = function (evt) {
							const imageDataUrl = evt.target.result;
							addNewWorkItem({ title, category, date, description, mediaType, youtubeUrl: '', image: imageDataUrl });
						};
						reader.readAsDataURL(fileInput.files[0]);
					} else {
						addNewWorkItem({ title, category, date, description, mediaType, youtubeUrl: '', image: '' });
					}
				}
			});

			function addNewWorkItem(data) {
				const newItem = {
					id: Date.now().toString(),
					title: data.title,
					category: data.category,
					type: data.mediaType,
					date: data.date,
					description: data.description,
					youtubeUrl: data.youtubeUrl,
					image: data.image
				};

				workItems.push(newItem);
				renderWork();

				form.reset();
				ytField?.classList.remove('hidden');
				imgField?.classList.add('hidden');
				modal?.classList.remove('active');
			}

			renderWork();
		</script>
	</body>
</html>

<style>
	main {
		width: auto;
		max-width: none;
		padding: 0;
	}
	.hero {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem 2rem;
		display: flex;
		align-items: center;
		min-height: 20vh;
	}
	.hero h1 {
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		line-height: 1;
		margin: 0;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #f2f2f0;
	}

	.work {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 2rem 8rem;
	}
	.work-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 1.25rem;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.work-header h2 {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: #f2f2f0;
	}

	.filter-tabs {
		display: flex;
		gap: 0.5rem;
	}
	.filter-btn {
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: rgba(242, 242, 240, 0.6);
		padding: 0.4rem 0.9rem;
		font-size: 0.85rem;
		border-radius: 4px;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.filter-btn:hover {
		color: #f2f2f0;
		border-color: rgba(255, 255, 255, 0.3);
	}
	.filter-btn.active {
		background: #f2f2f0;
		color: #141414;
		border-color: #f2f2f0;
		font-weight: 500;
	}

	.updated-at {
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.5);
		letter-spacing: 0.02em;
	}
	.updated-at span {
		color: #f2f2f0;
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 3.5rem 2rem;
	}

	.work-card {
		display: flex;
		flex-direction: column;
	}

	.video-embed-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #141414;
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	.video-embed-wrapper iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.thumb {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border-radius: 6px;
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.thumb-label {
		font-size: 0.75rem;
		color: rgba(242, 242, 240, 0.3);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.type-badge {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		background: rgba(20, 20, 20, 0.85);
		backdrop-filter: blur(4px);
		color: rgba(242, 242, 240, 0.8);
		font-size: 0.7rem;
		padding: 0.25rem 0.5rem;
		border-radius: 3px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.work-item-meta {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		margin-top: 1rem;
		gap: 1rem;
	}
	.meta-main {
		display: flex;
		flex-direction: column;
	}
	.work-item-meta h3 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		color: #f2f2f0;
		letter-spacing: -0.01em;
	}
	.work-item-meta .category {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.5);
	}
	.work-item-meta .description {
		margin: 0.5rem 0 0;
		font-size: 0.88rem;
		line-height: 1.4;
		color: rgba(242, 242, 240, 0.65);
	}
	.work-item-meta time {
		font-size: 0.82rem;
		color: rgba(242, 242, 240, 0.4);
		white-space: nowrap;
		padding-top: 0.2rem;
	}

	/* Floating Action Button (FAB) */
	.fab-btn {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: #f2f2f0;
		color: #141414;
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
		transition: transform 0.2s ease, background 0.2s ease;
		z-index: 100;
	}
	.fab-btn:hover {
		transform: scale(1.08);
		background: #ffffff;
	}

	/* Modal Styling */
	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background: rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(6px);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
		z-index: 200;
		padding: 1.5rem;
	}
	.modal-overlay.active {
		opacity: 1;
		pointer-events: auto;
	}

	.modal-card {
		background: #181818;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		width: 100%;
		max-width: 480px;
		padding: 1.75rem;
		color: #f2f2f0;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
	}

	.modal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}
	.modal-header h3 {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 500;
	}
	.close-btn {
		background: transparent;
		border: none;
		color: rgba(242, 242, 240, 0.5);
		font-size: 1.5rem;
		cursor: pointer;
		padding: 0;
		line-height: 1;
	}
	.close-btn:hover {
		color: #f2f2f0;
	}

	.form-group {
		margin-bottom: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.form-group.hidden {
		display: none;
	}
	.form-group label {
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.7);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.form-group input[type="text"],
	.form-group input[type="url"],
	.form-group input[type="date"],
	.form-group input[type="file"],
	.form-group textarea {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 6px;
		padding: 0.6rem 0.8rem;
		color: #f2f2f0;
		font-size: 0.9rem;
		font-family: inherit;
		outline: none;
	}
	.form-group input:focus,
	.form-group textarea:focus {
		border-color: rgba(255, 255, 255, 0.3);
	}

	.type-selector {
		display: flex;
		gap: 1rem;
		margin-top: 0.2rem;
	}
	.radio-label {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.8);
		cursor: pointer;
	}

	.submit-btn {
		width: 100%;
		padding: 0.75rem;
		background: #f2f2f0;
		color: #141414;
		border: none;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.88rem;
		cursor: pointer;
		margin-top: 0.5rem;
		transition: background 0.2s ease;
	}
	.submit-btn:hover {
		background: #ffffff;
	}

	@media (max-width: 900px) {
		.hero {
			padding: 3rem 1.5rem 2rem;
		}
		.work {
			padding: 2rem 1.5rem 6rem;
		}
		.work-grid {
			grid-template-columns: 1fr;
		}
		.work-header {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
