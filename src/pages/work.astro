---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const featuredWork = [
	{ title: 'Project One', category: 'Short Film', type: 'Videos', href: '/work/project-one' },
	{ title: 'Project Two', category: 'Commercial', type: 'Videos', href: '/work/project-two' },
	{ title: 'Project Three', category: 'Music Video', type: 'Videos', href: '/work/project-three' },
	{ title: 'Project Four', category: 'Documentary', type: 'Videos', href: '/work/project-four' },
	{ title: 'Photo Series A', category: 'Editorial', type: 'Photos', href: '/work/photo-series-a' },
	{ title: 'Photo Series B', category: 'Portrait', type: 'Photos', href: '/work/photo-series-b' },
];
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`My Work | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<h1>My Work</h1>
				</div>
			</section>

			<section class="work" id="work">
				<div class="work-header">
					<h2>Selected Work</h2>
					
					<!-- Filter Controls -->
					<div class="filter-tabs">
						<button class="filter-btn active" data-filter="all">All</button>
						<button class="filter-btn" data-filter="Videos">Videos</button>
						<button class="filter-btn" data-filter="Photos">Photos</button>
					</div>

					<a class="view-all" href="/work">View all &rarr;</a>
				</div>

				<div class="work-grid">
					{featuredWork.map((project) => (
						<a class="work-item" href={project.href} data-type={project.type}>
							<div class="thumb">
								<span class="thumb-label">Add thumbnail</span>
							</div>
							<div class="work-item-meta">
								<h3>{project.title}</h3>
								<p>{project.category}</p>
							</div>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// Client-side filtering logic
			const filterBtns = document.querySelectorAll('.filter-btn');
			const workItems = document.querySelectorAll('.work-item');

			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					// Toggle active tab styling
					filterBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');

					const filterValue = btn.getAttribute('data-filter');

					// Show/hide grid items based on selected category
					workItems.forEach(item => {
						const itemType = item.getAttribute('data-type');
						if (filterValue === 'all' || itemType === filterValue) {
							(item as HTMLElement).style.display = 'block';
						} else {
							(item as HTMLElement).style.display = 'none';
						}
					});
				});
			});
		</script>
	</body>
</html>

<style>
	main {
		width: auto;
		max-width: none;
		padding: 0;
	}
	.hero {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem 2rem;
		display: flex;
		align-items: center;
		min-height: 30vh;
	}
	.hero h1 {
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		line-height: 1;
		margin: 0;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #f2f2f0;
	}

	.work {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 2rem 8rem;
	}
	.work-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 1.25rem;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.work-header h2 {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: #f2f2f0;
	}

	/* Filter Tab Styles */
	.filter-tabs {
		display: flex;
		gap: 0.5rem;
	}
	.filter-btn {
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: rgba(242, 242, 240, 0.6);
		padding: 0.4rem 0.9rem;
		font-size: 0.85rem;
		border-radius: 4px;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.filter-btn:hover {
		color: #f2f2f0;
		border-color: rgba(255, 255, 255, 0.3);
	}
	.filter-btn.active {
		background: #f2f2f0;
		color: #141414;
		border-color: #f2f2f0;
		font-weight: 500;
	}

	.view-all {
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.55);
		text-decoration: none;
		letter-spacing: 0.03em;
		transition: color 0.25s ease;
	}
	.view-all:hover {
		color: #f2f2f0;
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 1.5rem;
	}
	.work-item {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.thumb {
		aspect-ratio: 16 / 10;
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.06);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		transition: border-color 0.25s ease;
	}
	.work-item:hover .thumb {
		border-color: rgba(255, 255, 255, 0.2);
	}
	.thumb-label {
		font-size: 0.75rem;
		color: rgba(242, 242, 240, 0.3);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.work-item-meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-top: 0.85rem;
	}
	.work-item-meta h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
		color: #f2f2f0;
	}
	.work-item-meta p {
		margin: 0;
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.45);
	}

	@media (max-width: 900px) {
		.hero {
			padding: 3rem 1.5rem 2rem;
			min-height: auto;
		}
		.work {
			padding: 2rem 1.5rem 6rem;
		}
		.work-grid {
			grid-template-columns: 1fr;
		}
		.work-header {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
