---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const stats = [
	{ value: 'Toronto, ON', label: 'Base Location' },
	{ value: '5+ Years', label: 'Creating Films & Visuals' },
	{ value: 'Digital & 35mm', label: 'Primary Mediums' },
];

const kitList = [
	'Digital & Cinema Systems',
	'35mm Film Cameras',
	'Prime Lenses',
	'Color Grading (DaVinci Resolve)',
	'Adobe Creative Cloud'
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<BaseHead title={`About — ${SITE_TITLE}`} description="Filmmaker and Photographer based in Toronto." />
	</head>
	<body>
		<Header />

		<main>
			<!-- Hero Header -->
			<section class="about-hero">
				<p class="eyebrow">03 / About</p>
				<h1>About Me</h1>
				<p class="lead">
					I’m Lleyton Lewis, a 19-year-old filmmaker and a 2029 Student of York University, furthering my knowledge of film to earn my BFA from the "Cinema and Media Arts - Production" program.
				</p>
			</section>

			<!-- Profile & Bio Section -->
			<section class="about-grid">
				<div class="portrait-wrapper">
					<img 
						src="/IMG_2525.jpg" 
						alt="Lleyton Lewis portrait" 
						class="portrait-img"
					/>
					<div class="portrait-caption">
						<span>Lleyton Lewis</span>
						<span class="dot"></span>
						<span>Toronto, ON</span>
					</div>
				</div>

				<div class="bio-content">
					<!-- Stats Row -->
					<div class="stats-row">
						{stats.map((stat) => (
							<div class="stat-item">
								<span class="stat-value">{stat.value}</span>
								<span class="stat-label">{stat.label}</span>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Toolkit / Equipment Section -->
			<section class="kit-section">
				<div class="kit-header">
					<h2>Tools &amp; Capabilities</h2>
					<p>Key mediums and software used across production workflows.</p>
				</div>
				<div class="kit-tags">
					{kitList.map((item) => (
						<span class="kit-tag">{item}</span>
					))}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: auto;
		max-width: none;
		padding: 0;
	}

	/* Hero Header */
	.about-hero {
		max-width: 900px;
		margin: 0 auto;
		padding: 4rem 2rem 2.5rem;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.5);
		margin: 0 0 1rem;
	}

	.about-hero h1 {
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		line-height: 1.05;
		margin: 0 0 1.25rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #f2f2f0;
	}

	.lead {
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.5;
		color: rgba(242, 242, 240, 0.75);
		max-width: 42ch;
		margin: 0;
	}

	/* Grid Layout - Tightened to remove huge gap */
	.about-grid {
		max-width: 900px;
		margin: 0 auto;
		padding: 1.5rem 2rem 4rem;
		display: grid;
		grid-template-columns: 260px 1fr;
		gap: 3.5rem;
		align-items: start;
	}

	.portrait-wrapper {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		width: 100%;
	}

	.portrait-img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 6px;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.portrait-caption {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.78rem;
		color: rgba(242, 242, 240, 0.45);
		letter-spacing: 0.03em;
	}

	.portrait-caption .dot {
		width: 4px;
		height: 4px;
		background: rgba(242, 242, 240, 0.3);
		border-radius: 50%;
	}

	/* Bio / Stats Column */
	.bio-content {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
	}

	.stats-row {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-left: 2rem;
		border-left: 1px solid rgba(255, 255, 255, 0.08);
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.stat-value {
		font-size: 1.15rem;
		font-weight: 600;
		color: #f2f2f0;
		letter-spacing: -0.01em;
	}

	.stat-label {
		font-size: 0.72rem;
		color: rgba(242, 242, 240, 0.45);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	/* Kit / Capabilities Section */
	.kit-section {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem 2rem 8rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.kit-header {
		margin-bottom: 1.5rem;
	}

	.kit-header h2 {
		font-size: 1.3rem;
		font-weight: 500;
		color: #f2f2f0;
		margin: 0 0 0.35rem;
	}

	.kit-header p {
		font-size: 0.85rem;
		color: rgba(242, 242, 240, 0.45);
		margin: 0;
	}

	.kit-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.kit-tag {
		padding: 0.55em 1em;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 100px;
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.7);
		letter-spacing: 0.02em;
	}

	/* Responsive Breakpoints */
	@media (max-width: 768px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.portrait-wrapper {
			max-width: 280px;
		}

		.stats-row {
			padding-left: 0;
			border-left: none;
			border-top: 1px solid rgba(255, 255, 255, 0.08);
			padding-top: 1.5rem;
		}
	}
</style>
