---
const today = new Date();

const socialLinks = [
	{
		name: 'Instagram',
		url: 'https://www.instagram.com/lleyton_lewis/',
		icon: 'instagram',
	},
	{
		name: 'Media Instagram',
		url: 'https://www.instagram.com/lleytonlewismedia/',
		icon: 'instagram',
	},
	{
		name: 'YouTube',
		url: 'https://www.youtube.com/@Lleyton_Lewis',
		icon: 'youtube',
	},
	{
		name: 'X/Twitter',
		url: 'https://x.com/LleytonLewis',
		icon: 'x',
	},
	{
		name: 'Letterboxd',
		url: 'https://letterboxd.com/LleytonLewis/',
		icon: 'letterboxd',
	},
];
---

<footer>
	<div class="footer-inner">
		<p>&copy; {today.getFullYear()} Lleyton Lewis. All rights reserved.</p>
		<div class="social-links">
			{socialLinks.map((link) => (
				<a href={link.url} target="_blank" rel="noopener noreferrer" title={link.name}>
					<span class="sr-only">{link.name}</span>
					{link.icon === 'instagram' && (
						<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
							<rect x="2.5" y="2.5" width="19" height="19" rx="5"></rect>
							<circle cx="12" cy="12" r="4.2"></circle>
							<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"></circle>
						</svg>
					)}
					{link.icon === 'youtube' && (
						<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
							<polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="currentColor" stroke="none"></polygon>
						</svg>
					)}
					{link.icon === 'x' && (
						<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="currentColor">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
					)}
					{link.icon === 'letterboxd' && (
						<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor">
							<circle cx="7" cy="12" r="3.5" opacity="0.9" />
							<circle cx="12" cy="12" r="3.5" opacity="0.9" />
							<circle cx="17" cy="12" r="3.5" opacity="0.9" />
						</svg>
					)}
				</a>
			))}
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 3rem 1rem 4rem;
		background: #080808;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.footer-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}
	footer p {
		margin: 0;
		color: rgba(242, 242, 240, 0.4);
		font-size: 0.8rem;
		letter-spacing: 0.03em;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		color: rgba(242, 242, 240, 0.45);
		transition: color 0.25s ease, transform 0.2s ease;
	}
	.social-links a:hover {
		color: #f2f2f0;
		transform: translateY(-1px);
	}

	/* Utility class for accessibility screen readers */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}
</style>
