---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

const navItems = [
	{ href: '/', label: 'Home', num: '01' },
	{ href: '/work', label: 'Work', num: '02' },
	{ href: '/about', label: 'About', num: '03' },
	{ href: '/contact', label: 'Contact', num: '04' },
];
---

<header class="site-header">
	<nav>
		<!-- Brand / Logo -->
		<a href="/" class="brand">
			<span class="brand-dot"></span>
			<span class="brand-text">{SITE_TITLE}</span>
			<span class="brand-badge">FILM &amp; PHOTO</span>
		</a>

		<!-- Desktop Navigation Links -->
		<div class="internal-links desktop-only">
			{navItems.map((item) => (
				<HeaderLink href={item.href} class="nav-pill">
					<span class="nav-num">{item.num}</span>
					<span class="nav-label">{item.label}</span>
				</HeaderLink>
			))}
		</div>

		<!-- Social Icons & Mobile Menu Toggle -->
		<div class="nav-actions">
			<div class="social-links desktop-only">
				<a href="https://www.instagram.com/lleyton_lewis/" target="_blank" rel="noopener noreferrer" title="Instagram">
					<span class="sr-only">Instagram</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
						<rect x="2.5" y="2.5" width="19" height="19" rx="5"></rect>
						<circle cx="12" cy="12" r="4.2"></circle>
						<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"></circle>
					</svg>
				</a>
				<a href="https://x.com/LleytonLewis" target="_blank" rel="noopener noreferrer" title="X / Twitter">
					<span class="sr-only">X</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="currentColor">
						<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
					</svg>
				</a>
			</div>

			<!-- Mobile Menu Button -->
			<button id="mobile-menu-btn" class="menu-toggle" aria-label="Toggle Navigation Menu">
				<span class="bar top-bar"></span>
				<span class="bar bottom-bar"></span>
			</button>
		</div>
	</nav>

	<!-- Mobile Navigation Drawer -->
	<div id="mobile-menu" class="mobile-drawer">
		<div class="mobile-drawer-inner">
			<div class="mobile-links">
				{navItems.map((item) => (
					<HeaderLink href={item.href} class="mobile-nav-item">
						<span class="mobile-num">{item.num}</span>
						<span class="mobile-label">{item.label}</span>
						<span class="mobile-arrow">&rarr;</span>
					</HeaderLink>
				))}
			</div>

			<div class="mobile-footer">
				<p>Toronto, Canada</p>
				<div class="mobile-socials">
					<a href="https://www.instagram.com/lleyton_lewis/" target="_blank" rel="noopener noreferrer">Instagram</a>
					<a href="https://letterboxd.com/LleytonLewis/" target="_blank" rel="noopener noreferrer">Letterboxd</a>
					<a href="https://www.youtube.com/@Lleyton_Lewis" target="_blank" rel="noopener noreferrer">YouTube</a>
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	// Toggle mobile drawer
	const menuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');

	menuBtn?.addEventListener('click', () => {
		const isOpen = menuBtn.classList.toggle('active');
		mobileMenu?.classList.toggle('open');
		document.body.style.overflow = isOpen ? 'hidden' : '';
	});
</script>

<style>
	/* Header Container */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(8, 8, 8, 0.75);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.75rem;
		height: 4.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	/* Brand & Logo */
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: #f2f2f0;
		font-weight: 600;
		letter-spacing: -0.01em;
		transition: opacity 0.25s ease;
	}
	.brand:hover {
		opacity: 0.85;
	}
	.brand-dot {
		width: 7px;
		height: 7px;
		background: #83e878; /* Subtle warm golden dot */
		border-radius: 50%;
		display: inline-block;
		box-shadow: 0 0 8px rgba(232, 185, 120, 0.6);
	}
	.brand-text {
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.brand-badge {
		font-size: 0.62rem;
		padding: 0.2em 0.55em;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 100px;
		color: rgba(242, 242, 240, 0.5);
		letter-spacing: 0.08em;
		font-weight: 500;
		margin-left: 0.3rem;
	}

	/* Desktop Navigation Pills */
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		background: rgba(255, 255, 255, 0.03);
		padding: 0.25rem 0.35rem;
		border-radius: 100px;
		border: 1px solid rgba(255, 255, 255, 0.06);
	}

	:global(.nav-pill) {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.95rem;
		border-radius: 100px;
		color: rgba(242, 242, 240, 0.6);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.nav-num {
		font-size: 0.68rem;
		font-family: monospace;
		opacity: 0.45;
		transition: color 0.25s ease, opacity 0.25s ease;
	}

	:global(.nav-pill:hover) {
		color: #f2f2f0;
		background: rgba(255, 255, 255, 0.07);
	}

	:global(.nav-pill.active) {
		color: #080808 !important;
		background: #f2f2f0 !important;
		font-weight: 600;
		box-shadow: 0 2px 10px rgba(255, 255, 255, 0.15);
	}

	:global(.nav-pill.active) .nav-num {
		color: #080808;
		opacity: 0.65;
	}

	/* Actions & Social Links */
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.social-links a {
		color: rgba(242, 242, 240, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: color 0.25s ease, transform 0.2s ease;
	}

	.social-links a:hover {
		color: #f2f2f0;
		transform: translateY(-1px);
	}

	/* Mobile Toggle Button */
	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
		width: 38px;
		height: 38px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 50%;
		cursor: pointer;
		padding: 0 10px;
		transition: background 0.25s ease;
	}

	.menu-toggle .bar {
		display: block;
		width: 100%;
		height: 1.5px;
		background: #f2f2f0;
		transition: transform 0.3s ease, opacity 0.3s ease;
		transform-origin: center;
	}

	.menu-toggle.active .top-bar {
		transform: translateY(3.75px) rotate(45deg);
	}

	.menu-toggle.active .bottom-bar {
		transform: translateY(-3.75px) rotate(-45deg);
	}

	/* Mobile Navigation Drawer */
	.mobile-drawer {
		display: none;
		position: fixed;
		top: 4.5rem;
		left: 0;
		right: 0;
		bottom: 0;
		height: calc(100vh - 4.5rem);
		background: #080808;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
		z-index: 99;
	}

	.mobile-drawer.open {
		opacity: 1;
		pointer-events: auto;
	}

	.mobile-drawer-inner {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
		padding: 2.5rem 2rem 4rem;
	}

	.mobile-links {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	:global(.mobile-nav-item) {
		display: flex;
		align-items: center;
		padding: 1.1rem 1.25rem;
		background: #121212;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 10px;
		text-decoration: none;
		color: #f2f2f0;
		transition: border-color 0.25s ease, background 0.25s ease;
	}

	:global(.mobile-nav-item.active) {
		border-color: rgba(232, 185, 120, 0.4);
		background: rgba(232, 185, 120, 0.08);
	}

	.mobile-num {
		font-family: monospace;
		font-size: 0.75rem;
		color: rgba(242, 242, 240, 0.4);
		margin-right: 1.2rem;
	}

	.mobile-label {
		font-size: 1.2rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		flex-grow: 1;
	}

	.mobile-arrow {
		font-size: 1rem;
		color: rgba(242, 242, 240, 0.3);
	}

	.mobile-footer {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding-top: 2rem;
	}

	.mobile-footer p {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		color: rgba(242, 242, 240, 0.4);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.mobile-socials {
		display: flex;
		gap: 1.25rem;
	}

	.mobile-socials a {
		color: rgba(242, 242, 240, 0.75);
		text-decoration: none;
		font-size: 0.9rem;
	}

	/* Responsive Breakpoints */
	@media (max-width: 820px) {
		.desktop-only {
			display: none !important;
		}
		.menu-toggle {
			display: flex;
		}
		.mobile-drawer {
			display: block;
		}
		.brand-badge {
			display: none;
		}
	}
</style>
