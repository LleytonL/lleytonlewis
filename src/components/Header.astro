---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

const navItems = [
	{ href: '/', label: 'Home', num: '01' },
	{ href: '/work', label: 'Work', num: '02' },
	{ href: '/about', label: 'About', num: '03' },
	{ href: '/contact', label: 'Contact', num: '04' },
];
---

<header class="site-header">
	<nav>
		<!-- Brand / Logo -->
		<a href="/" class="brand">
			<span class="brand-dot"></span>
			<span class="brand-text">{SITE_TITLE}</span>
		</a>

		<!-- Navigation Links -->
		<div class="internal-links">
			{navItems.map((item) => (
				<HeaderLink href={item.href} class="nav-pill">
					<span class="nav-num">{item.num}</span>
					<span class="nav-label">{item.label}</span>
				</HeaderLink>
			))}
		</div>

		<!-- Desktop Social Links -->
		<div class="social-links desktop-only">
			<a href="https://www.instagram.com/lleyton_lewis/" target="_blank" rel="noopener noreferrer" title="Instagram">
				<span class="sr-only">Instagram</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
					<rect x="2.5" y="2.5" width="19" height="19" rx="5"></rect>
					<circle cx="12" cy="12" r="4.2"></circle>
					<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"></circle>
				</svg>
			</a>
			<a href="https://www.instagram.com/lleytonlewismedia" target="_blank" rel="noopener noreferrer" title="Instagram 2">
				<span class="sr-only">Instagram</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
			<a href="https://x.com/LleytonLewis" target="_blank" rel="noopener noreferrer" title="X / Twitter">
				<span class="sr-only">X</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	/* Header Container */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(8, 8, 8, 0.85);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		height: 4.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	/* Brand & Logo */
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: #f2f2f0;
		font-weight: 600;
		letter-spacing: -0.01em;
		transition: opacity 0.25s ease;
		flex-shrink: 0;
	}
	.brand:hover {
		opacity: 0.85;
	}
	.brand-dot {
		width: 7px;
		height: 7px;
		background: #83e878;
		border-radius: 50%;
		display: inline-block;
		box-shadow: 0 0 8px rgba(131, 232, 120, 0.6);
	}
	.brand-text {
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}
	.brand-badge {
		font-size: 0.62rem;
		padding: 0.2em 0.55em;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 100px;
		color: rgba(242, 242, 240, 0.5);
		letter-spacing: 0.08em;
		font-weight: 500;
		margin-left: 0.3rem;
	}

	/* Navigation Pills Container */
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		background: rgba(255, 255, 255, 0.03);
		padding: 0.25rem;
		border-radius: 100px;
		border: 1px solid rgba(255, 255, 255, 0.06);
	}

	:global(.nav-pill) {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 0.35rem;
		padding: 0.45rem 0.85rem;
		border-radius: 100px;
		color: rgba(242, 242, 240, 0.6);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		white-space: nowrap;
	}

	.nav-num {
		font-size: 0.65rem;
		font-family: monospace;
		opacity: 0.45;
		transition: color 0.25s ease, opacity 0.25s ease;
	}

	.nav-label {
		display: inline-block;
		text-align: center;
	}

	:global(.nav-pill:hover) {
		color: #f2f2f0;
		background: rgba(255, 255, 255, 0.07);
	}

	:global(.nav-pill.active) {
		color: #080808 !important;
		background: #f2f2f0 !important;
		font-weight: 600;
		box-shadow: 0 2px 10px rgba(255, 255, 255, 0.15);
	}

	:global(.nav-pill.active) .nav-num {
		color: #080808;
		opacity: 0.65;
	}

	/* Social Links */
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
	}

	.social-links a {
		color: rgba(242, 242, 240, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: color 0.25s ease, transform 0.2s ease;
	}

	.social-links a:hover {
		color: #f2f2f0;
		transform: translateY(-1px);
	}

	/* Accessibility helper */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}

	/* Mobile Responsive Styles */
	@media (max-width: 820px) {
		.desktop-only {
			display: none !important;
		}

		.brand-badge {
			display: none;
		}

		nav {
			padding: 0 1rem;
		}

		.nav-num {
			display: none; /* Hide numbers on mobile so text centers without offset */
		}
	}

	@media (max-width: 520px) {
		nav {
			flex-direction: column;
			justify-content: center;
			height: auto;
			padding: 0.85rem 0.75rem;
			gap: 0.75rem;
		}

		.internal-links {
			width: 100%;
			justify-content: space-between;
			padding: 0.2rem;
		}

		:global(.nav-pill) {
			flex: 1;
			text-align: center;
			justify-content: center;
			padding: 0.45rem 0;
			font-size: 0.78rem;
		}
	}
</style>
