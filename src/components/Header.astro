---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---
<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/work">Work</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://instagram.com/" target="_blank">
				<span class="sr-only">Instagram</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
					<rect x="2.5" y="2.5" width="19" height="19" rx="5"></rect>
					<circle cx="12" cy="12" r="4.2"></circle>
					<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"></circle>
				</svg>
			</a>
			<a href="https://vimeo.com/" target="_blank">
				<span class="sr-only">Vimeo</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M22 7.05c-.08 1.7-1.27 4.03-3.57 6.98C16.05 17.1 14.1 18.6 12.5 18.6c-1 0-1.84-.92-2.53-2.76l-1.38-5.07c-.5-1.84-1.05-2.76-1.63-2.76-.13 0-.57.27-1.33.8L5 8.02c.83-.73 1.65-1.46 2.46-2.19 1.11-.96 1.94-1.47 2.5-1.52 1.32-.13 2.13.78 2.44 2.72.33 2.1.56 3.4.68 3.92.38 1.72.8 2.58 1.25 2.58.35 0 .88-.55 1.58-1.66.7-1.1 1.08-1.95 1.13-2.53.1-.96-.28-1.44-1.13-1.44-.4 0-.82.09-1.24.27.83-2.7 2.4-4.02 4.7-3.94 1.72.05 2.53 1.16 2.43 3.32z" stroke="none" fill="currentColor"></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 2rem;
		background: rgba(8, 8, 8, 0.85);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		position: sticky;
		top: 0;
		z-index: 50;
	}
	h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #f2f2f0;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4.5rem;
	}
	.internal-links {
		display: flex;
		gap: 0.5rem;
	}
	nav .internal-links a {
		position: relative;
		padding: 0.5em 0.75em;
		color: rgba(242, 242, 240, 0.65);
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.25s ease;
	}
	nav .internal-links a::after {
		content: '';
		position: absolute;
		left: 0.75em;
		right: 0.75em;
		bottom: 0.35em;
		height: 1px;
		background: #f2f2f0;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}
	nav .internal-links a:hover,
	nav .internal-links a.active {
		color: #f2f2f0;
	}
	nav .internal-links a:hover::after,
	nav .internal-links a.active::after {
		transform: scaleX(1);
	}
	.social-links {
		display: flex;
		gap: 1.1rem;
	}
	.social-links a {
		color: rgba(242, 242, 240, 0.55);
		display: flex;
		transition: color 0.25s ease;
	}
	.social-links a:hover {
		color: #f2f2f0;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
